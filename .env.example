# CredResolve Intelligence - Environment Configuration Template
# Copy this file to .env and configure for your deployment environment.

PROJECT_NAME="CredResolve Intelligence — AI-Powered Collections & Recovery Platform"
API_V1_STR="/api/v1"

# JWT Authentication Secret Key (generate a secure random 256-bit secret for production)
# Example command to generate: openssl rand -hex 32
SECRET_KEY="your-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for zero-config local run; PostgreSQL ready)
DATABASE_URL="sqlite:///./credresolve.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://credresolve_user:credresolve_pass@localhost:5432/credresolve_db"

# Data Ingestion Directory
DATA_RAW_DIR="./data/raw"

# Allowed CORS Origins (set specific domains in production)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","http://127.0.0.1:8000","http://localhost:8000"]

# Google OAuth 2.0 (Optional — configure in Google Cloud Console)
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_DEFAULT_ROLE="agent"

# Frontend Vite Google Client ID (for React @react-oauth/google if enabled)
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
